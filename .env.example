# DevPilot backend — local 예시 (실제 값은 .env에 넣고 커밋하지 않는다)
# 전체 목록과 prod 값 위치: docs/10-deployment-and-operations.md §6 (환경변수·secret 매트릭스), docs/18 §5.2
# 서버 주소·계정·비밀번호는 저장소 밖 DevPilot-ops/ (01-servers.md, 02-database.md) 에만 둔다.

# SPRING_PROFILES_ACTIVE 는 여기에 두지 않는다 (./gradlew bootRun 이 local 지정, docs/18 §4.4)

# Database — 서버 PostgreSQL 16 (공용 인스턴스, DB devpilot / role devpilot, TLS 없음). 기본값 없음: 비우면 기동 실패
# 오프라인 대체: docker compose -f infra/compose.dev.yml up -d → jdbc:postgresql://localhost:55432/devpilot (devpilot/devpilot)
DATABASE_URL=jdbc:postgresql://<server>:5432/devpilot
DATABASE_USERNAME=devpilot
DATABASE_PASSWORD=<password>

# 인증 (결정 A) — devtoken | supabase. devtoken: POST /api/v1/dev/token {email} → JWT
DEVPILOT_AUTH_MODE=devtoken
# devtoken 서명 키 (EC P-256 private key PEM). 비우면 기동 시 생성(재기동 시 기존 토큰 무효). prod 필수
# 여러 줄인 PEM은 \n 으로 이어 한 줄로 쓴다 (앱이 되돌린다 — 구현 시 확인). 생성: openssl ecparam -genkey -name prime256v1 -noout
DEVPILOT_DEV_JWT_KEY=

# 접근 제어 (쉼표 구분, 소문자). 로컬은 본인 이메일 하나
DEVPILOT_ALLOWED_EMAILS=<your-email>
DEVPILOT_ALLOWED_SUBJECTS=
# 로그 userRef HMAC 키: 64 hex chars (`openssl rand -hex 32`), prod 필수
DEVPILOT_LOG_HASH_KEY=

# AI — local 기본은 fake (실제 호출이 필요할 때만 deepseek + 키). DeepSeek 키는 sk- + hex 32자
DEVPILOT_AI_PROVIDER=fake
DEVPILOT_AI_MODEL=deepseek-flash
DEVPILOT_AI_MONTHLY_BUDGET_USD=3
# RestClient 가 Spring property 로 읽으므로 .env 에 둬도 된다 (prod·eval 과 같은 잔액, 결정 E)
DEEPSEEK_API_KEY=

# Web
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 로컬 테스트용 서버 Docker (선택, docs/18 §3.1). infra/scripts/dev-docker-tunnel.ps1 이 안내한다.
# 이 파일은 Spring 만 읽는다 — Testcontainers 가 보도록 OS/IDE 환경변수로 준다 (.env 에서는 주석 유지)
#DOCKER_HOST=tcp://localhost:2375
#TESTCONTAINERS_HOST_OVERRIDE=<server-tailnet-ip>

# Later: Supabase Auth 도입 시 (DEVPILOT_AUTH_MODE=supabase 일 때만 읽는다)
#SUPABASE_URL=https://<project-ref>.supabase.co
#SUPABASE_JWT_ALGORITHM=ES256
