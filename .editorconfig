root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java: google-java-format AOSP 스타일 (DEC-09) — 실제 포맷은 Spotless가 결정
[*.java]
indent_size = 4
max_line_length = 100

[*.{kt,kts}]
indent_size = 4

# Dart: analysis_options.yaml formatter.page_width 100
[*.dart]
indent_size = 2
max_line_length = 100

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.sql]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[{Caddyfile,Makefile}]
indent_style = tab
