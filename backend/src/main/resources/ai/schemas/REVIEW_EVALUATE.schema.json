{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devpilot/ai/REVIEW_EVALUATE.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rubric",
    "feedback"
  ],
  "properties": {
    "rubric": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "met"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[1-6]$"
          },
          "met": {
            "type": "boolean"
          }
        }
      }
    },
    "feedback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    }
  }
}
