{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devpilot/ai/LESSON_REEXPLAIN.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "explanation",
    "analogy"
  ],
  "properties": {
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "analogy": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
